+package json
+
+import "github.com/goccy/go-json/internal/encoder"
+
+// CodeSetCounts returns the counts of the lookups of the code sets, for a measurement only.
+func CodeSetCounts() (lookups, misses, shared int) {
+	return encoder.CountRecentLookups, encoder.CountRecentMisses, encoder.CountSharedLookups
+}
+
+// ResetCodeSetCounts resets them.
+func ResetCodeSetCounts() {
+	encoder.CountRecentLookups, encoder.CountRecentMisses, encoder.CountSharedLookups = 0, 0, 0
+}
