 	return append(append(b, code.KeyChunk[:half]...), code.KeyChunk[half:]...)[:len(b)+len(code.Key)]
 }
 
+// growForKey returns b with the capacity for a chunk of a key after it.
+//
+//go:noinline
+func growForKey(b []byte) []byte {
+	return append(b, make([]byte, encoder.KeyChunkSize)...)[:len(b)]
+}
+
