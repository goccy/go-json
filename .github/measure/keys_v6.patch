+			if call, ok := n.(*ast.CallExpr); ok {
+				if ident, ok := call.Fun.(*ast.Ident); ok && ident.Name == "appendStructKey" {
+					call.Fun = ast.NewIdent("appendStructKey16")
+				}
+			}
+			return true
