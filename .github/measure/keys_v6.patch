+
+// isKey16Candidate is whether the opcode is the one of a field or an end of a field of a type, not the generic
+// one, which may have a key longer than two chunks, nor the one of a run.
+func isKey16Candidate(op string) bool {
+	switch op {
+	case "StructField", "StructFieldOmitEmpty", "StructEnd", "StructEndOmitEmpty":
+		return false
+	}
+	for _, typ := range fieldRunTypes {
+		if op == "StructField"+typ+"2" || op == "StructField"+typ+"3" {
+			return false
+		}
+	}
+	return strings.HasPrefix(op, "StructField") || strings.HasPrefix(op, "StructEnd")
+}
+
+// writesStructKey is whether the case writes a key by appendStructKey and does not fall through.
+func writesStructKey(clause *ast.CaseClause) bool {
+	var key, fallthroughs bool
+	for _, stmt := range clause.Body {
+		ast.Inspect(stmt, func(n ast.Node) bool {
+			switch n := n.(type) {
+			case *ast.CallExpr:
+				if ident, ok := n.Fun.(*ast.Ident); ok && ident.Name == "appendStructKey" {
+					key = true
+				}
+			case *ast.BranchStmt:
+				if n.Tok == token.FALLTHROUGH {
+					fallthroughs = true
+				}
+			}
+			return true
+		})
+	}
+	return key && !fallthroughs
+}
+
+// addKey16Cases adds the cases of the opcodes of key16Ops to the switch of Run: the plain VM has a case of its
+// own for each, which writes the key by appendStructKey16, and the other VMs, which write a key as they do
+// any key, take the opcode in the case of the opcode it is the one for a short key of.
+func addKey16Cases(f *ast.File, plain bool) {
+	var sw *ast.SwitchStmt
+	ast.Inspect(f, func(n ast.Node) bool {
+		if s, ok := n.(*ast.SwitchStmt); ok && sw == nil {
+			if sel, ok := s.Tag.(*ast.SelectorExpr); ok && sel.Sel.Name == "Op" {
+				sw = s
+			}
+		}
+		return true
+	})
+	clonesOf := map[*ast.CaseClause]*ast.CaseClause{}
+	forEachFieldCase(f, func(clause *ast.CaseClause, op string) {
+		expr := &ast.SelectorExpr{X: ast.NewIdent("encoder"), Sel: ast.NewIdent("Op" + op + key16Suffix)}
+		if !plain {
+			clause.List = append(clause.List, expr)
+			return
+		}
+		clone := cloneCase(clause)
+		clone.List = []ast.Expr{expr}
