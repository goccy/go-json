+	// was, so that the cases of the fields stay together.
+	var list []ast.Stmt
+	for _, stmt := range sw.Body.List {
+		list = append(list, stmt)
+		if clause, ok := stmt.(*ast.CaseClause); ok && clonesOf[clause] != nil {
+			list = append(list, clonesOf[clause])
+		}
+	}
+	sw.Body.List = list
+}
+
+// cloneCase returns a copy of the case, printed and parsed again.
+func cloneCase(clause *ast.CaseClause) *ast.CaseClause {
+	var buf bytes.Buffer
+	buf.WriteString("package p\nfunc f() {\nswitch {\n")
+	printer.Fprint(&buf, token.NewFileSet(), clause)
+	buf.WriteString("\n}\n}\n")
+	f, err := parser.ParseFile(token.NewFileSet(), "", buf.String(), 0)
+	if err != nil {
+		panic(err)
+	}
+	return f.Decls[0].(*ast.FuncDecl).Body.List[0].(*ast.SwitchStmt).Body.List[0].(*ast.CaseClause)
+}
