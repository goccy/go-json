+
+// forEachFieldCase calls fn for each case of the switch of Run with one opcode of a field of a type, not of a
+// run, which writes the key by appendStructKey and does not fall through.
+func forEachFieldCase(f *ast.File, fn func(clause *ast.CaseClause, op string)) {
+	ast.Inspect(f, func(n ast.Node) bool {
+		clause, ok := n.(*ast.CaseClause)
+		if !ok || len(clause.List) != 1 {
+			return true
+		}
+		sel, ok := clause.List[0].(*ast.SelectorExpr)
+		if !ok {
+			return true
+		}
+		op := strings.TrimPrefix(sel.Sel.Name, "Op")
+		if !isKey16Candidate(op) || !writesStructKey(clause) {
+			return true
+		}
+		fn(clause, op)
+		return true
+	})
