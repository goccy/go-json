+
+// isKey16Candidate is whether the opcode is the one of a field or an end of a field of a type, not the generic
+// one, which may have a key longer than two chunks, nor the one of a run.
+func isKey16Candidate(op string) bool {
+	switch op {
+	case "StructField", "StructFieldOmitEmpty", "StructEnd", "StructEndOmitEmpty":
+		return false
+	}
+	for _, typ := range fieldRunTypes {
+		if op == "StructField"+typ+"2" || op == "StructField"+typ+"3" {
+			return false
+		}
+	}
+	return strings.HasPrefix(op, "StructField")
+}
+
+// writesStructKey is whether the case writes a key by appendStructKey and does not fall through.
+func writesStructKey(clause *ast.CaseClause) bool {
+	var key, fallthroughs bool
+	for _, stmt := range clause.Body {
+		ast.Inspect(stmt, func(n ast.Node) bool {
+			switch n := n.(type) {
+			case *ast.CallExpr:
+				if ident, ok := n.Fun.(*ast.Ident); ok && ident.Name == "appendStructKey" {
+					key = true
+				}
+			case *ast.BranchStmt:
+				if n.Tok == token.FALLTHROUGH {
+					fallthroughs = true
+				}
+			}
+			return true
+		})
+	}
+	return key && !fallthroughs
+}
+
+// addKey16Cases returns the source of the template with the cases of the opcodes of key16Ops: the plain VM has
+// a case of its own for each, right after the case it is a copy of, which writes the key by appendStructKey16,
+// and the other VMs, which write a key as they do any key, take the opcode in the case it is the one for a short
+// key of. The cases are copied as the text they are in the template, with their comments.
+func addKey16Cases(src []byte, plain bool) ([]byte, error) {
+	fset := token.NewFileSet()
+	f, err := parser.ParseFile(fset, "", src, parser.ParseComments)
+	if err != nil {
+		return nil, err
+	}
+	type edit struct {
+		offset int
+		text   string
+	}
+	var edits []edit
+	forEachFieldCase(f, func(clause *ast.CaseClause, op string) {
+		label := "encoder.Op" + op
+		key16 := label + key16Suffix
+		if !plain {
+			// the opcode for a short key is added to the list of the case.
+			edits = append(edits, edit{offset: fset.Position(clause.List[0].End()).Offset, text: ", " + key16})
+			return
+		}
+		start, end := fset.Position(clause.Pos()).Offset, fset.Position(clause.End()).Offset
+		text := string(src[start:end])
+		text = strings.Replace(text, "case "+label+":", "case "+key16+":", 1)
+		text = strings.ReplaceAll(text, "appendStructKey(", "appendStructKey16(")
