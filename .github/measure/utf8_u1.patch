+DATA c80x32<>+8(SB)/8, $0x8080808080808080
+DATA c80x32<>+16(SB)/8, $0x8080808080808080
+DATA c80x32<>+24(SB)/8, $0x8080808080808080
+GLOBL c80x32<>(SB), RODATA|NOPTR, $32
