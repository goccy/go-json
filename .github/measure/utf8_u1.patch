-	VPCMPEQB     Y4, Y3, Y4
-	VPCMPEQB     Y15, Y2, Y6
+	VPCMPEQB     cE2x32<>(SB), Y3, Y4
+	VPCMPEQB     c80x32<>(SB), Y2, Y6
 	VPAND        Y6, Y4, Y4
-	VPBROADCASTB cFE<>(SB), Y6
-	VPAND        Y6, Y0, Y6
-	VPBROADCASTB cA8<>(SB), Y1
-	VPCMPEQB     Y1, Y6, Y6
+	VPAND        cFEx32<>(SB), Y0, Y6
+	VPCMPEQB     cA8x32<>(SB), Y6, Y6
 	VPAND        Y6, Y4, Y4
 	VPOR         Y4, Y7, Y7
 	VPTEST       Y7, Y7
@@ -317,15 +313,34 @@ udone:
