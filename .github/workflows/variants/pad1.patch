+
+// padLayout1 only moves the code after it, to measure the effect of the layout.
+//
+//go:noinline
+func padLayout1(x []int) int {
+	s := 0
+	for _, v := range x {
+		s += v * 1
+	}
+	for _, v := range x {
+		s += v * 2
+	}
+	for _, v := range x {
+		s += v * 3
+	}
+	for _, v := range x {
+		s += v * 4
+	}
+	for _, v := range x {
+		s += v * 5
+	}
+	for _, v := range x {
+		s += v * 6
+	}
+	return s
+}
+
+var padLayoutSink1 = padLayout1(nil)
